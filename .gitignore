# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
*.lnk
.vscode/
.idea/
*.swp
*~

# Env / secrets
.env
.env.*
!.env.example
credentials.json
*.pem

# Dependencies / local venv
node_modules/
mistralvenv/
.venv/
venv/
__pycache__/
*.pyc

# Go TUI local toolchain / build artifacts
.go-toolchain/
tui/.toolchain/
tui/stormwreck
tui/stormwreck.exe
tui/stormwreck-linux-armv7

# Logs / junk
*.log
npm-debug.log*
.cursor/

# Copyrighted / local source PDFs (keep out of the repo)
source/*.pdf

# File-backed data: track normal library JSON/assets; ignore ephemeral churn
data/.tmp/
data/**/*.tmp
data/**/*.tmp.*
data/.backup/

# Local UVTT dumps / import scratch (never seed these)
*.dd2vtt
*.uvtt
!test/fixtures/**

# Runtime map assets (campaign-map path is legacy; catalogue uses maps/location/)
data/assets/maps/campaign-map/
data/assets/uvtt/
data/campaigns/*/maps.json

# Player PC catalogue mirrors created at runtime (keep intentional seed PCs tracked)
data/catalogues/pc/pc-p3b-a-*.json

# Accidental uploads under static assets/
assets/maps/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*.jpg
assets/maps/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*.png
assets/maps/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*.webp

# Music catalogue audio binaries (metadata JSON stays tracked if seeded; never commit MP3s)
data/assets/audio/
data/catalogues/music/*.json
!data/catalogues/music/.gitkeep
