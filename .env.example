# Copy to .env for local Postgres / Railway.
# Never commit real secrets.

# Node server
HOST=127.0.0.1
PORT=3000

# Optional override for file-backed data (default: <repo>/data)
# DM_DATA_ROOT=

# PostgreSQL — when unset, the app keeps using file-backed /data only
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Future auth (Phase 3+) — not required for Phase 1
# SESSION_SECRET=
# AUTH_DEV_USER_ID=
