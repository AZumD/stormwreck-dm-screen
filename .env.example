# Copy to .env for local Postgres / Railway.
# Never commit real secrets.

# Node server
HOST=127.0.0.1
PORT=3000
# NODE_ENV=production
#   Production requires: DATABASE_URL, SESSION_SECRET (≥32), DM_DATA_ROOT (persistent volume).
#   HOST defaults to 0.0.0.0 when NODE_ENV=production if unset.

# File-backed library root (default: <repo>/data). Required in production — mount volume here.
# DM_DATA_ROOT=/data

# PostgreSQL — when unset, the app keeps using file-backed /data only
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Auth (Phase 3A)
# Local: AUTH_REQUIRED=0 (default) keeps DM file APIs open without login.
# Production (NODE_ENV=production): auth is always required regardless of AUTH_REQUIRED.
AUTH_REQUIRED=0
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=14
# COOKIE_SECURE=1       # force Secure cookies (auto on production / TRUST_PROXY=1)
# TRUST_PROXY=1         # set behind Railway HTTPS terminator

# One-shot ops (NEVER put these in npm start / automatic deploy):
#   npm run data:init          # empty volume only
#   npm run db:migrate
#   npm run db:seed:items
#   npm run db:seed:characters # OVERWRITES character_state (HP/conditions) — once only
#   npm run db:bootstrap:auth

# Dev bootstrap (npm run db:bootstrap:auth) — never commit real passwords
# BOOTSTRAP_DM_EMAIL=dm@example.local
# BOOTSTRAP_DM_PASSWORD=
# BOOTSTRAP_DM_NAME=DM
# BOOTSTRAP_PLAYER_EMAIL=player@example.local
# BOOTSTRAP_PLAYER_PASSWORD=
# BOOTSTRAP_PLAYER_NAME=Player
# BOOTSTRAP_CAMPAIGN_ID=stormwreck-isle
# BOOTSTRAP_CHARACTER_IDS=pc-mswdvrcy-u6nnt

# Music catalogue audio storage (optional S3-compatible / Railway bucket).
# When unset, MP3s are stored under {DM_DATA_ROOT}/assets/audio/ (local default).
# AUDIO_S3_BUCKET=
# AUDIO_S3_ENDPOINT=           # e.g. https://t3.storageapi.dev or Railway object endpoint
# AUDIO_S3_REGION=auto
# AUDIO_S3_ACCESS_KEY_ID=
# AUDIO_S3_SECRET_ACCESS_KEY=
# AUDIO_S3_FORCE_PATH_STYLE=1  # usually 1 for S3-compatible providers
